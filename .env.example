# Copy to .env and fill in locally. Never commit .env.

# Personal Nasdaq Data Link API key (https://data.nasdaq.com/account/profile).
NASDAQ_API_KEY=

# Root directory of the local data lake (raw/, curated/, features/, ...).
# Must live outside version control or in a gitignored path.
ALPHAFLOW_DATA_DIR=./data

# Logging verbosity: DEBUG, INFO, WARNING, ERROR.
ALPHAFLOW_LOG_LEVEL=INFO
